  "captions": [
    {
      "text": "ถ้าค้างคาววิวัฒนาการจนไม่ต้องนอน",
      "startMs": 0.0,
      "endMs": 2600.0,
      "timestampMs": null,
      "confidence": null,
      "shot": "01"
    },
    {
      "text": "จะเกิดอะไรขึ้น?",
      "startMs": 2600.0,
      "endMs": 4000.0,
      "timestampMs": null,
      "confidence": null,
      "shot": "01"
    },
    {
      "text": "มันมีเวลาว่างตอนกลางวัน",
      "startMs": 4000.0,
      "endMs": 5866.666666666667,
      "timestampMs": null,
      "confidence": null,
      "shot": "02"
    },
    {
      "text": "เลยตัดสินใจไปเป็นชาวนา",
      "startMs": 5866.666666666667,
      "endMs": 7766.666666666667,
      "timestampMs": null,
      "confidence": null,
      "shot": "02"
    },
    {
      "text": "กลางวันดำนา กลางคืนไล่แมลง",
      "startMs": 7766.666666666667,
      "endMs": 10433.333333333334,
      "timestampMs": null,
      "confidence": null,
      "shot": "03"
    },
    {
      "text": "ปีแรกเก็บเกี่ยวได้เต็มนา",
      "startMs": 10433.333333333334,
      "endMs": 12433.333333333334,
      "timestampMs": null,
      "confidence": null,
      "shot": "04"
    },
    {
      "text": "ชาวบ้านซื้อจนหมด เกลี้ยงยุ้ง!",
      "startMs": 12433.333333333334,
      "endMs": 14433.333333333334,
      "timestampMs": null,
      "confidence": null,
      "shot": "04"
    },
    {
      "text": "ปีต่อมาคนเลยสั่งข้าวทั้งหมู่บ้าน",
      "startMs": 14433.333333333334,
      "endMs": 17333.333333333332,
      "timestampMs": null,
      "confidence": null,
      "shot": "05"
    },
    {
      "text": "มันรีบขยายแปลง เตรียมรวยแล้วคราวนี้!",
      "startMs": 17333.333333333332,
      "endMs": 20500.0,
      "timestampMs": null,
      "confidence": null,
      "shot": "05"
    },
    {
      "text": "แต่ค้างคาวยังชอบอยู่ที่สูง",
      "startMs": 20500.0,
      "endMs": 22666.666666666668,
      "timestampMs": null,
      "confidence": null,
      "shot": "06"
    },
    {
      "text": "เลยสร้างยุ้งข้าวไว้บนต้นไม้!",
      "startMs": 22666.666666666668,
      "endMs": 25133.333333333332,
      "timestampMs": null,
      "confidence": null,
      "shot": "06"
    },
    {
      "text": "ขนขึ้นทีละรวง สะสมทั้งปี",
      "startMs": 25133.333333333332,
      "endMs": 27633.333333333332,
      "timestampMs": null,
      "confidence": null,
      "shot": "07"
    },
    {
      "text": "จนกระสอบข้าวเต็มยุ้ง รอส่งลูกค้า",
      "startMs": 27633.333333333332,
      "endMs": 30533.333333333332,
      "timestampMs": null,
      "confidence": null,
      "shot": "07"
    },
    {
      "text": "คืนก่อนส่ง พายุเข้าอย่างหนัก",
      "startMs": 30533.333333333332,
      "endMs": 32733.333333333332,
      "timestampMs": null,
      "confidence": null,
      "shot": "08"
    },
    {
      "text": "พัดบันไดหายไปทั้งอัน!",
      "startMs": 32733.333333333332,
      "endMs": 34500.0,
      "timestampMs": null,
      "confidence": null,
      "shot": "08"
    },
    {
      "text": "พอรถมารับ มันก็บินขึ้นไปทันที",
      "startMs": 34500.0,
      "endMs": 37166.666666666664,
      "timestampMs": null,
      "confidence": null,
      "shot": "09"
    },
    {
      "text": "แต่บินตัวเปล่า กับแบกข้าวมันคนละเรื่อง!",
