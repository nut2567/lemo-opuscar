{
  "fps": 30,
  "frames": 4291,
  "duration": 143.03333333333333,
  "voice": {
    "engine": "edge-tts",
    "name": "th-TH-NiwatNeural",
    "access": "free"
  },
  "shots": [
    {
      "id": "01",
      "start": 0.0,
      "end": 8.3,
      "captions": [
        {
          "start": 0.08,
          "end": 2.3276458333333334,
          "text": "ถ้ามดที่ขยันเก็บของทั้งปี"
        },
        {
          "start": 2.3676458333333334,
          "end": 5.221979166666666,
          "text": "วิวัฒนาการจนกดสั่งของออนไลน์เป็น"
        },
        {
          "start": 5.261979166666666,
          "end": 6.941979166666667,
          "text": "จะเกิดอะไรขึ้น?"
        }
      ]
    },
    {
      "id": "02",
      "start": 8.3,
      "end": 15.4,
      "captions": [
        {
          "start": 8.56,
          "end": 10.732020833333333,
          "text": "ในสวนหลังบ้าน มีมดแดงตัวหนึ่ง"
        },
        {
          "start": 10.772020833333332,
          "end": 12.452020833333334,
          "text": "ขยันที่สุดในรัง"
        },
        {
          "start": 12.492020833333333,
          "end": 14.710041666666667,
          "text": "ตื่นก่อนใคร กลับรังทีหลังใคร"
        }
      ]
    },
    {
      "id": "03",
      "start": 15.4,
      "end": 23.5,
      "captions": [
        {
          "start": 15.66,
          "end": 17.946770833333336,
          "text": "ทั้งปีมันแบกเม็ดน้ำตาล ทีละเม็ด"
        },
        {
          "start": 17.986770833333335,
          "end": 20.28247916666667,
          "text": "เก็บเข้าห้องเก็บของ จนเต็มทุกชั้น"
        },
        {
          "start": 20.322479166666668,
          "end": 22.827583333333333,
          "text": "เพราะรู้ว่าหน้าหนาว จะไม่มีอะไรกิน"
        }
      ]
    },
    {
      "id": "04",
      "start": 23.5,
      "end": 29.3,
      "captions": [
        {
          "start": 23.76,
          "end": 26.517416666666666,
          "text": "ราชินีมดยังชม ว่ามันคือมดตัวอย่าง"
        },
        {
          "start": 26.557416666666665,
          "end": 28.631416666666667,
          "text": "ใครอยากมีเก็บ ให้ดูมันไว้"
        }
      ]
    },
    {
      "id": "05",
      "start": 29.3,
      "end": 35.266666666666666,
      "captions": [
        {
          "start": 29.56,
          "end": 32.867979166666665,
          "text": "จนวันหนึ่ง มีคนทำมือถือตกไว้ในสนามหญ้า"
        },
        {
          "start": 32.907979166666664,
          "end": 34.596916666666665,
          "text": "จอยังสว่าง แบตยังเต็ม"
        }
      ]
    },
    {
      "id": "06",
      "start": 35.266666666666666,
      "end": 42.1,
      "captions": [
        {
          "start": 35.526666666666664,
          "end": 37.20666666666667,
          "text": "มันเดินขึ้นไปบนจอ"
        },
        {
          "start": 37.24666666666667,
          "end": 38.9876875,
          "text": "หนวดแตะปุ๊บ แอปเด้งปั๊บ"
        },
        {
          "start": 39.0276875,
          "end": 41.42839583333333,
          "text": "แอปช้อปปิ้ง ของชิ้นละบาท ส่งฟรี!"
        }
      ]
    },
    {
      "id": "07",
      "start": 42.1,
      "end": 49.2,
      "captions": [
        {
          "start": 42.36,
          "end": 44.70527083333334,
          "text": "มันลองกดสั่งน้ำตาลมาหนึ่งถุง"
        },
        {
          "start": 44.745270833333336,
          "end": 46.425270833333336,
          "text": "ไม่ต้องแบก ไม่ต้องเดิน"
        },
        {
          "start": 46.465270833333335,
          "end": 48.51360416666667,
          "text": "สองวันก็มาส่งถึงหน้ารัง!"
        }
      ]
    },
    {
      "id": "08",
      "start": 49.2,
      "end": 56.833333333333336,
      "captions": [
        {
          "start": 49.46,
          "end": 51.14,
          "text": "นี่แหละวิวัฒนาการ!"
        },
        {
          "start": 51.18,
          "end": 53.042458333333336,
          "text": "มันฝึกกดเร็วขึ้นทุกวัน"
        },
        {
          "start": 53.082458333333335,
          "end": 56.15195833333333,
          "text": "จนหนวดสองข้าง กดมือถือได้สองเครื่องพร้อมกัน"
        }
      ]
    },
    {
      "id": "09",
      "start": 56.833333333333336,
      "end": 63.96666666666667,
      "captions": [
        {
          "start": 57.093333333333334,
          "end": 58.77333333333333,
          "text": "พอถึงวันสิบเอ็ดสิบเอ็ด"
        },
        {
          "start": 58.81333333333333,
          "end": 60.49333333333333,
          "text": "ลดทั้งแอป"
        },
        {
          "start": 60.53333333333333,
          "end": 63.2749375,
          "text": "มันกดน้ำตาล กดหมอน กดไฟประดับรัง"
        }
      ]
    },
    {
      "id": "10",
      "start": 63.96666666666667,
      "end": 71.9,
      "captions": [
        {
          "start": 64.22666666666667,
          "end": 66.83560416666666,
          "text": "วันสิบสองสิบสอง มีโค้ดส่งฟรีอีก"
        },
        {
          "start": 66.87560416666666,
          "end": 69.04497916666666,
          "text": "มันกดบ้านตุ๊กตา กดลำโพง"
        },
        {
          "start": 69.08497916666667,
          "end": 71.22341666666667,
          "text": "แถมรองเท้าผ้าใบ ครบหกข้าง"
        }
      ]
    },
    {
      "id": "11",
      "start": 71.9,
      "end": 79.2,
      "captions": [
        {
          "start": 72.16,
          "end": 74.20389583333333,
          "text": "ทุกเช้า มีกล่องมาส่งหน้ารัง"
        },
        {
          "start": 74.24389583333334,
          "end": 76.11120833333332,
          "text": "กล่องเดียว ใหญ่กว่ารังทั้งรัง"
        },
        {
          "start": 76.15120833333333,
          "end": 77.83120833333332,
          "text": "ประตูรังก็เข้าไม่ได้"
        }
      ]
    },
    {
      "id": "12",
      "start": 79.2,
      "end": 86.03333333333333,
      "captions": [
        {
          "start": 79.46,
          "end": 81.32391666666666,
          "text": "เพื่อนมดเลยต้องมาช่วยกันแบก"
        },
        {
          "start": 81.36391666666667,
          "end": 83.04391666666666,
          "text": "ต่อแถวยาวเหยียด"
        },
        {
          "start": 83.08391666666667,
          "end": 85.357625,
          "text": "แบกกล่องวันละสิบรอบ จนขาสั่น"
        }
      ]
    },
    {
      "id": "13",
      "start": 86.03333333333333,
      "end": 93.0,
      "captions": [
        {
          "start": 86.29333333333334,
          "end": 87.97518749999999,
          "text": "ราชินีเริ่มถามว่า"
        },
        {
          "start": 88.0151875,
          "end": 89.84272916666666,
          "text": "เงินที่เก็บไว้ ยังอยู่ไหม?"
        },
        {
          "start": 89.88272916666666,
          "end": 92.31216666666666,
          "text": "มันรีบตอบว่า เหลือเยอะครับ ไม่ต้องห่วง!"
        }
      ]
    },
    {
      "id": "14",
      "start": 93.0,
      "end": 99.7,
      "captions": [
        {
          "start": 93.26,
          "end": 94.95766666666665,
          "text": "แต่มันลืมดูอยู่อย่างเดียว"
        },
        {
          "start": 94.99766666666666,
          "end": 96.67766666666667,
          "text": "บรรทัดเล็ก ๆ ในแอป"
        },
        {
          "start": 96.71766666666667,
          "end": 99.006875,
          "text": "ที่เขียนว่า ผ่อนสบาย จ่ายปลายเดือน"
        }
      ]
    },
    {
      "id": "15",
      "start": 99.7,
      "end": 107.5,
      "captions": [
        {
          "start": 99.96,
          "end": 101.64224999999999,
          "text": "แล้วลมหนาวก็มาถึง"
        },
        {
          "start": 101.68225,
          "end": 103.36224999999999,
          "text": "ใบไม้ร่วง หญ้าเหี่ยว"
        },
        {
          "start": 103.40225,
          "end": 106.15272916666666,
          "text": "ทุกรังปิดประตู เตรียมอยู่ยาวทั้งหน้าหนาว"
        }
      ]
    },
    {
      "id": "16",
      "start": 107.5,
      "end": 115.4,
      "captions": [
        {
          "start": 107.76,
          "end": 109.44,
          "text": "มันเปิดห้องเก็บของ"
        },
        {
          "start": 109.48,
          "end": 111.76841666666667,
          "text": "น้ำตาลที่สั่งมา กินไปหมดแล้ว"
        },
        {
          "start": 111.80841666666667,
          "end": 114.04606249999999,
          "text": "เงินเก็บทั้งปี ก็จ่ายไปหมดแล้ว"
        }
      ]
    },
    {
      "id": "17",
      "start": 115.4,
      "end": 120.23333333333333,
      "captions": [
        {
          "start": 115.66,
          "end": 117.82810416666666,
          "text": "เพื่อนที่ช่วยแบก ก็เหนื่อยจนแรงหมด"
        },
        {
          "start": 117.86810416666667,
          "end": 119.54810416666666,
          "text": "มือถือก็แบตหมด"
        }
      ]
    },
    {
      "id": "18",
      "start": 120.23333333333333,
      "end": 128.16666666666666,
      "captions": [
        {
          "start": 120.49333333333334,
          "end": 122.17333333333333,
          "text": "ในห้องเหลือแต่กล่องเปล่า"
        },
        {
          "start": 122.21333333333334,
          "end": 123.96777083333333,
          "text": "ซ้อนกันสูงถึงเพดาน"
        },
        {
          "start": 124.00777083333334,
          "end": 126.81902083333333,
          "text": "กับมดหนึ่งตัว ที่ยังนั่งดูของลดราคาอยู่"
        }
      ]
    },
    {
      "id": "19",
      "start": 128.16666666666666,
      "end": 135.86666666666667,
      "captions": [
        {
          "start": 128.42666666666668,
          "end": 130.96589583333335,
          "text": "ราชินีมองหน้ามันแล้วถอนหายใจ"
        },
        {
          "start": 131.00589583333334,
          "end": 133.1013125,
          "text": "ก่อนจะประกาศต่อหน้ามดทั้งรัง"
        },
        {
          "start": 133.1413125,
          "end": 135.193125,
          "text": "ว่าต่อไปนี้ เธอต้องมีชื่อใหม่"
        }
      ]
    },
    {
      "id": "20",
      "start": 135.86666666666667,
      "end": 140.86666666666667,
      "captions": [
        {
          "start": 136.12666666666667,
          "end": 137.80666666666667,
          "text": "จากมดที่ขยันที่สุด"
        },
        {
          "start": 137.84666666666666,
          "end": 139.52666666666667,
          "text": "กลายเป็น หมด!"
        }
      ]
    },
    {
      "id": "21",
      "start": 140.86666666666667,
      "end": 143.03333333333333,
      "captions": [
        {
          "start": 141.12666666666667,
          "end": 142.8511041666667,
          "text": "และนี่เป็นเหตุผลที่ว่า"
        }
      ]
    }
  ]
}